<Project>
  <!-- Shared settings for every project in the Consolify solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>Consolify contributors</Authors>
    <Copyright>Copyright (C) 2026 Consolify contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TomSzo/Consolify</RepositoryUrl>
  </PropertyGroup>
</Project>
